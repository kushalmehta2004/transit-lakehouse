# Copy to .env and adjust. docker compose reads .env automatically;
# every value below also has a working default baked into docker-compose.yml.

# --- Object store (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_BUCKET=lakehouse

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP=redpanda:9092

# --- Iceberg catalog (Postgres) + Spark ---
CATALOG_DB_USER=iceberg
CATALOG_DB_PASSWORD=iceberg
BRONZE_TRIGGER_SECONDS=10
SILVER_TRIGGER_SECONDS=30
SILVER_WATERMARK=15 minutes
SCHEDULE_TIMEZONE=America/New_York

# --- GTFS feed: MBTA (Boston), no API key required ---
GTFS_RT_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
GTFS_RT_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
GTFS_STATIC_URL=https://cdn.mbta.com/MBTA_GTFS.zip
POLL_INTERVAL_SECONDS=15
KAFKA_RAW_PARTITIONS=6
SCHEDULE_REFRESH_HOURS=24

# --- Memory (phase 5 slimming; measured heap use: bronze 0.74 GB, thrift 1.0 GB, silver 1.75 GB) ---
SPARK_DRIVER_MEMORY=1g
SPARK_SILVER_DRIVER_MEMORY=2g
SPARK_THRIFT_DRIVER_MEMORY=1536m

# --- Airflow / Grafana logins (local only) ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Bronze throughput (phase 6 load test) ---
# 1 = one write task per batch (fewest files) -> ceiling ~2-5k ev/s on one core.
# 6 = one task per Kafka partition -> sustained 10k ev/s; hourly compaction absorbs the extra files.
BRONZE_WRITE_PARTITIONS=6
# Optional backpressure cap on messages per micro-batch (empty = unlimited)
BRONZE_MAX_OFFSETS_PER_TRIGGER=
