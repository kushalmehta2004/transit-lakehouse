# Copy to .env and adjust. docker compose reads .env automatically;
# every value below also has a working default baked into docker-compose.yml.

# --- Object store (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_BUCKET=lakehouse

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP=redpanda:9092

# --- Iceberg catalog (Postgres) + Spark ---
CATALOG_DB_USER=iceberg
CATALOG_DB_PASSWORD=iceberg
BRONZE_TRIGGER_SECONDS=10
SPARK_DRIVER_MEMORY=2g

# --- GTFS feed: MBTA (Boston), no API key required ---
GTFS_RT_VEHICLE_POSITIONS_URL=https://cdn.mbta.com/realtime/VehiclePositions.pb
GTFS_RT_TRIP_UPDATES_URL=https://cdn.mbta.com/realtime/TripUpdates.pb
GTFS_STATIC_URL=https://cdn.mbta.com/MBTA_GTFS.zip
POLL_INTERVAL_SECONDS=15
KAFKA_RAW_PARTITIONS=6
SCHEDULE_REFRESH_HOURS=24
